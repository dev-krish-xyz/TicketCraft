# ──────────────────────────────────────────────
# Copy this file to .env.local and fill in values
# ──────────────────────────────────────────────

# Database — Neon PostgreSQL (neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Auth.js — generate secret: npx auth secret
AUTH_URL=http://localhost:3000
AUTH_SECRET=your_auth_secret_here
AUTH_GITHUB_ID=your_github_oauth_app_id
AUTH_GITHUB_SECRET=your_github_oauth_app_secret

# AI Providers — at least one required
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key      # aistudio.google.com
GROQ_API_KEY=your_groq_api_key                         # console.groq.com

# File Uploads — Uploadthing (uploadthing.com)
UPLOADTHING_TOKEN=your_uploadthing_token

# Webhooks — optional, for Sentry integration
SENTRY_WEBHOOK_SECRET=your_sentry_webhook_secret
